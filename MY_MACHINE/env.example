# The watcher's settings: copy to ~/.config/gamemaker/env, chmod 600, and fill in. One KEY=value per line.
# The header of VPS/agent/watch.py lists every setting and its default.
# /home/you stands for your home folder. Write full paths: PATH, CLAUDE_BIN and OUTSIDE_SANDBOX are used as they
# are written (no ~ and no $HOME there). The layout is the author's machine's, with placeholders where its own
# names were.

# The board, and the agent's login. The password comes from var/credentials.txt on the board's machine (the line
# that starts with "agent"). Never in git, and never on a command line. This file is not the only place that
# holds it: see "What this does not protect against" in the top-level README.
GAMEMAKER_URL=https://board.example.com
GAMEMAKER_USER=agent
GAMEMAKER_PASS=<the agent's password for the board: never in git>

# The two working copies, side by side: the game's source (where the runs work) and the clone of the site
# repository that GitHub Pages publishes. WORK_BRANCH is the git branch of the board's main line.
WORK_DIR=/home/you/Projects/gamemaker-world
WORK_BRANCH=world
SITE_DIR=/home/you/Projects/your-game-web
PAGES_URL=https://your-name.github.io/your-game-web/

# Claude Code, and the PATH for it and its commands: the output of `command -v claude` and of `echo $PATH`
# in a login shell. No folder of it may be one a run can write.
CLAUDE_BIN=/home/you/.local/bin/claude
PATH=/home/you/.local/bin:/home/you/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin

# Who the runs commit as. Left out, it is "Lelelilo Gamemaker <gamemaker@example.com>": the author's name for the
# runs, and a placeholder address. Set yours. The address shows in the site's public history.
GIT_NAME=Gamemaker
GIT_EMAIL=gamemaker@example.com

# The cost cap for one prompt, in dollars at API prices. 10 is the watcher's default; 0 means no cap. The watcher
# passes it to Claude Code (--max-budget-usd), which enforces it: a run can end somewhat past it.
# The author's machine has 0 here and relies on the time limit (RUN_TIMEOUT, 7200 seconds by default), which the
# watcher enforces itself.
MAX_COST=10

# What the author's game adds to the sandbox's lists: Binaryen for the web build, the build folder, and the script
# of the browser checks. SANDBOX_READ and SANDBOX_WRITE start with the watcher's two defaults, repeated, because
# setting a list replaces its default. OUTSIDE_SANDBOX has no default. Yours will differ: leave these out until
# `watch.py check --try` shows that a command of your build or tests needs one.
#SANDBOX_READ=~/.cargo ~/.rustup ~/.local/share/binaryen
#SANDBOX_WRITE=~/.cargo/registry ~/.cargo/git /data/scratch/gamemaker-world
#OUTSIDE_SANDBOX=/home/you/.local/share/gamemaker/test-in-browser.sh
